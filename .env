DATABASE_URL=postgresql://neuro_admin:neuro_password@localhost:5432/neurostage_db
INTERNAL_SECRET=neuro_secret
NESTJS_INTERNAL_URL=http://app:3000
UPLOAD_DIR=/var/neurostage/uploads
UPLOAD_BASE_URL=http://localhost:3000
ENVIRONMENT=development

# --- Development with Ollama (free, local) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=llama3.2
EMBEDDING_DIMENSIONS=768
OPENAI_API_KEY=

